1 ICON "res\\app.ico"
1 24 "app.manifest"

1 VERSIONINFO
FILEVERSION 0,1,0,0
PRODUCTVERSION 0,1,0,0
FILEOS 0x00040004L
FILETYPE 0x00000001L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "Windows Charging Reminder"
            VALUE "FileDescription", "Windows Charging Reminder"
            VALUE "FileVersion", "0.1.0"
            VALUE "InternalName", "WindowsChargingReminder"
            VALUE "OriginalFilename", "WindowsChargingReminder.exe"
            VALUE "ProductName", "Windows Charging Reminder"
            VALUE "ProductVersion", "0.1.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
